# Скопируйте файл в .env.local и заполните значения.
# .env.local в git не попадает — ключи остаются только на вашей машине и в настройках хостинга.

# Ключ API из личного кабинета Resend: https://resend.com/api-keys
RESEND_API_KEY=

# Кому приходят заявки. Можно указать несколько адресов через запятую.
# Если не задать — письма уйдут на info@oberon.kz из src/content/site.ts
ZAYAVKA_TO=info@oberon.kz

# От чьего имени уходит письмо. Домен нужно подтвердить в Resend,
# иначе письма не будут доставляться: https://resend.com/domains
ZAYAVKA_FROM=Сайт oberon.kz <zayavka@oberon.kz>
